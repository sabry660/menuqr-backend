# Copy this file to .env and adjust values for your environment.
# NEVER commit a real .env file.

APP_ENV=development
APP_NAME=MenuQR API
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://menuqr:menuqr@localhost:5432/menuqr

# --- JWT / Security -----------------------------------------------------------
# Generate a strong secret for production, e.g.: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_DEV_ONLY_INSECURE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48
INVITATION_TOKEN_EXPIRE_DAYS=7

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins. Do not use "*" with credentials in production.
CORS_ORIGINS=http://localhost:3000

FRONTEND_URL=http://localhost:3000

# --- Redis (rate limiting / cache / jobs) --------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Email ----------------------------------------------------------------------
# EMAIL_PROVIDER=console prints emails to stdout; use smtp in production.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@menuqr.local

# --- Storage ----------------------------------------------------------------
# STORAGE_BACKEND=local|s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
MAX_UPLOAD_SIZE_MB=5

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3

# --- AI Service (Groq LLM) ---------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
AI_SERVICE_API_KEY=your_ai_service_api_key_here
LLM_PRIMARY_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_MODEL=
LLM_TIMEOUT=60.0
LLM_MAX_OUTPUT_TOKENS=8192
MAX_CONCURRENT_LLM_CALLS=10
